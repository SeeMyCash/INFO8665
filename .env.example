# Copy this file to `.env` and replace placeholder values before running the stack.

# App + AWS model sync
ENABLE_AWS_MODEL_SYNC=0
S3_REGION=us-east-1
ARTIFACTS_BUCKET=
ARTIFACTS_PREFIX=output
SPOOF_GUARD_ENABLED=0

# App storage + secrets
APP_STORAGE_BACKEND=database
APP_LOCAL_STORAGE_PATH=/training/outputs/app-data/inference-history.jsonl
APP_STORAGE_MAX_HISTORY=250
APP_SECRETS_DIR=/run/secrets

# Database connection
DB_DRIVER=postgresql+psycopg
DB_HOSTNAME=db
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_NAME=smc_app
DB_USERNAME=smc_app
DB_PASSWORD=replace-with-local-dev-password
DB_SSLMODE=disable
# Optional overrides for mounted secret files:
# DB_USERNAME_FILE=/run/secrets/db_username
# DB_PASSWORD_FILE=/run/secrets/db_password
# DATABASE_URL=

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PREFIX=INFO8665
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=file:///mlflow/artifacts

# Optional dataset + training credentials
ROBOFLOW_API_KEY=
SAGEMAKER_ROLE_ARN=
SAGEMAKER_BUCKET=
SAGEMAKER_SCREEN_DATASET_PREFIX=screen-detection/datasets/screen_coco128_v1
SAGEMAKER_SCREEN_OUTPUT_PREFIX=screen-detection/models
